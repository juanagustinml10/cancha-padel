# URL base de la API. En desarrollo se usa el proxy de Vite hacia http://localhost:4000.
VITE_API_URL=/api/v1

# Nombre provisional del club (reemplazable).
VITE_APP_NAME=PADEL CLUB

# Modo demostración: true usa datos ficticios claramente identificados (sin backend).
# Poner en false cuando la API real esté disponible.
VITE_USE_MOCKS=true

# Número de WhatsApp para contacto (formato internacional, sin +), opcional.
VITE_WHATSAPP=5491100000000
