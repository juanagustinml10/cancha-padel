# ---------------------------------------------------------------------------
# PADEL CLUB · Backend (apps/api)
# Copiá este archivo a `.env` y completá los valores reales.
# NUNCA versiones el archivo `.env` (está en .gitignore).
# ---------------------------------------------------------------------------

# Entorno: development | test | production
NODE_ENV=development
# Puerto HTTP del API
PORT=4000
# Zona horaria del negocio (zona del club). PostgreSQL guarda timestamptz en UTC.
TZ=America/Argentina/Buenos_Aires

# --- Base de datos ---------------------------------------------------------
# Cadena de conexión de PostgreSQL (Prisma). Ajustá usuario/clave/host/base.
DATABASE_URL=postgresql://padel:CHANGE_ME@localhost:5432/padel?schema=public
# Base de datos dedicada a las pruebas de integración/concurrencia.
# Si se deja vacía, esas pruebas se OMITEN automáticamente.
TEST_DATABASE_URL=

# --- Sesiones y seguridad --------------------------------------------------
# Secreto para firmas internas de sesión. Generá uno largo y aleatorio.
SESSION_SECRET=change-me-use-a-long-random-value
# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:5173
# Duración de la sesión en horas.
SESSION_TTL_HOURS=12

# --- Reglas comerciales ----------------------------------------------------
CLUB_NAME=PADEL CLUB
BOOKING_HOLD_MINUTES=20
DEPOSIT_MODE=percent            # percent | fixed_amount
DEPOSIT_PERCENT=30
DEPOSIT_FIXED_AMOUNT_CENTS=500000
CURRENCY=ARS

# --- URLs públicas (retornos y notificaciones) -----------------------------
# Base pública del frontend (para las URLs de retorno del checkout).
APP_BASE_URL=http://localhost:5173
# Base pública del API (para construir la URL de notificación del webhook).
API_BASE_URL=http://localhost:4000
# En producción AMBAS deben ser HTTPS (se valida al arrancar).

# --- Mercado Pago (dejar vacío hasta tener credenciales reales) ------------
# Con el proveedor en modo "fake" (default) no se realizan cobros reales.
# Con PAYMENTS_PROVIDER=mercadopago son OBLIGATORIOS MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET.
# Se aceptan también los nombres MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_PUBLIC_KEY,
# MERCADOPAGO_WEBHOOK_SECRET, MERCADOPAGO_NOTIFICATION_URL y MERCADOPAGO_*_URL.
PAYMENTS_PROVIDER=fake          # fake | mercadopago
# Access Token de la aplicación (Panel de Mercado Pago > Tus integraciones).
MP_ACCESS_TOKEN=
# Public Key de la aplicación (se expone al frontend si se usa Checkout Bricks).
MP_PUBLIC_KEY=
# Clave secreta de firma de webhooks (Panel > Webhooks > Clave secreta).
MP_WEBHOOK_SECRET=
# URL de notificación. Si se deja vacía se usa ${API_BASE_URL}/api/v1/webhooks/mercadopago
MP_NOTIFICATION_URL=
# URLs de retorno. Si se dejan vacías se usa ${APP_BASE_URL}/reserva/<código>.
# Podés fijarlas al frontend y el código de reserva se resuelve desde el estado local.
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# --- Datos de ejemplo (SEED) ----------------------------------------------
# El seed es solo para desarrollo/pruebas. No ejecutar en producción.
SEED_ADMIN_EMAIL=admin@padelclub.example
SEED_ADMIN_PASSWORD=CambiarEstaClave123
SEED_RECEPTION_EMAIL=recepcion@padelclub.example
SEED_RECEPTION_PASSWORD=CambiarEstaClave123
